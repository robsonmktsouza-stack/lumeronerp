<UserControl x:Class="Lumeron.UI.LumeronRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lumeron.UI"
             mc:Ignorable="d"
             d:DesignHeight="135"
             d:DesignWidth="1200">

    <Grid x:Name="RibbonLayout"
          Background="#FFF7F7F7">

        <Ribbon x:Name="MainRibbon"
                Loaded="MainRibbon_Loaded"
                Background="#FFF7F7F7"
                BorderThickness="0">

            <!-- Oculta o menu azul -->
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed"/>
            </Ribbon.ApplicationMenu>

            <!-- Oculta a barra de acesso rápido -->
            <Ribbon.QuickAccessToolBar>
                <RibbonQuickAccessToolBar Visibility="Collapsed"/>
            </Ribbon.QuickAccessToolBar>

            <!-- Abas principais -->
            <RibbonTab Header="Início"/>
            <RibbonTab Header="Cadastros"/>
            <RibbonTab Header="Vendas"/>
            <RibbonTab Header="Estoque"/>
            <RibbonTab Header="Financeiro"/>
            <RibbonTab Header="Fiscal"/>

        </Ribbon>

    </Grid>

</UserControl>
