<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta unica para as telas desktop do Lumeron. -->
    <SolidColorBrush x:Key="LumeronWindowBrush" Color="#F1F4F8"/>
    <SolidColorBrush x:Key="LumeronPanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LumeronRibbonBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="LumeronStatusBrush" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="LumeronBorderBrush" Color="#D8E0EA"/>
    <SolidColorBrush x:Key="LumeronAccentBrush" Color="#205D95"/>
    <SolidColorBrush x:Key="LumeronAccentSoftBrush" Color="#EAF1F8"/>
    <SolidColorBrush x:Key="LumeronTextBrush" Color="#1D3048"/>
    <SolidColorBrush x:Key="LumeronMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="LumeronSuccessBrush" Color="#29946C"/>

    <!-- Abas de documentos: mantem aspecto de aplicativo nativo. -->
    <Style x:Key="LumeronWorkspaceTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LumeronTextBrush}"/>
        <Setter Property="Padding" Value="17,8"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabSurface"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface"
                                    Property="Background"
                                    Value="{StaticResource LumeronAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface"
                                    Property="Background"
                                    Value="{StaticResource LumeronPanelBrush}"/>
                            <Setter TargetName="TabSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource LumeronBorderBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource LumeronAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
