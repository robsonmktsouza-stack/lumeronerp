<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lumeron.Desktop"
        xmlns:UI="clr-namespace:Lumeron.UI;assembly=Lumeron.UI" x:Class="Lumeron.Desktop.MainWindow"
        mc:Ignorable="d"
        Title="Lumeron - Gestão Empresarial" Height="800" Width="1280" MinWidth="1024">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Border x:Name="RibbonContainer" BorderBrush="#FFC8CDD3" BorderThickness="0,1,0,1" Height="NaN" Background="#FFF7F7F7">
            <UI:LumeronRibbon Margin="0,-1,0,-1"/>
        </Border>
    </Grid>

</Window>
